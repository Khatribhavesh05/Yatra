# ==========================================
# Root .gitignore for ChargeEase
# ==========================================

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Editor & IDE Files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
*.keystore
*.jks
key.properties
local.properties

# Node / Frontend / Admin Dashboard
node_modules/
dist/
dist-ssr/
build/
.pnp
.pnp.js
*.local

# Python / Backend
__pycache__/
*.py[cod]
*$py.class
*.so
venv/
.venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.db
*.sqlite
*.sqlite3
backend/test.db

# Flutter / Dart / Mobile
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
chargeease_mobile/build/
chargeease_mobile/.dart_tool/
chargeease_mobile/coverage/
.widget_preview/
app.*.symbols
app.*.map.json

# Test Artifacts & Temp Files
test_dark.gif
test_light.gif
